---
import Shell from '../layouts/Shell.astro';
import Command from '../components/Command.astro';

const contact = [
  { key: 'github', label: 'github.com/giovannirossini', href: 'https://github.com/giovannirossini' },
  { key: 'linkedin', label: 'linkedin.com/in/rossinigiovanni', href: 'https://www.linkedin.com/in/rossinigiovanni' },
  { key: 'medium', label: 'medium.com/@rossinigiovanni', href: 'https://medium.com/@rossinigiovanni' },
  { key: 'email', label: 'giovannirossini@duck.com', href: 'mailto:giovannirossini@duck.com' },
];
const pad = Math.max(...contact.map((c) => c.key.length)) + 2;
---

<Shell
  tab="contact"
  title="Contact | Giovanni Rossini"
  description="Find Giovanni Rossini on GitHub, LinkedIn and Medium, or send an email."
>
  <Command cmd="cat contact.txt" label="Contact" id="contact" level={1}>
    <ul class="contact">
      {contact.map((c) => (
        <li>
          <span class="dim" aria-hidden="true">{c.key.padEnd(pad)}</span><a href={c.href}><span class="sr-only">{c.key}: </span>{c.label}</a>
        </li>
      ))}
    </ul>
    <p class="comment">
      # this site is built with astro. <a href="https://github.com/giovannirossini/giovannirossini.github.io">source</a>
    </p>
  </Command>
</Shell>
